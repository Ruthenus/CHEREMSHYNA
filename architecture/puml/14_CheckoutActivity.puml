@startuml CheckoutActivity
title Гастроном «Черемшина» — купити і оформити\nвід картки товару до історії в кабінеті

skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
  BackgroundColor #F5E6D3
  BorderColor #8c2240
  FontColor #1a0508
  DiamondBackgroundColor #FFF8E7
  DiamondBorderColor #8c2240
  DiamondFontColor #1a0508
  StartColor #8c2240
  EndColor #8c2240
  BarColor #8c2240
}
skinparam arrow {
  Color #5c2b2f
}
skinparam note {
  BackgroundColor #FFF8E7
  BorderColor #c4a574
  FontColor #1a0508
}

start
:Products, кнопка «КУПИТИ»;
note right
  Вимкнена, якщо немає зв'язку з API
  або stock вже 0.
end note
:App.addToCart\nне більше min(99, stock);
:cheremshyna_cart у localStorage\nбейдж у Header;
:/cart;

if (Кошик порожній?) then (так)
  :«До продукції»;
  stop
else (ні)
endif

:«ОФОРМИТИ ЗАМОВЛЕННЯ»;

if (Є сесія?) then (так)
else (ні)
  :/login, from = /order;
  note right
    Кошик не стирається.
    Після входу Login повертає на /order,
    не на /cabinet.
  end note
endif

:/order;

if (Кошик ще є і користувач увійшов?) then (так)
  :POST /api/orders/preview/\nсума вже зі знижкою сервера;
else (ні)
  :порожній кошик або запрошення увійти;
  stop
endif

:Ім'я, телефон, самовивіз або доставка;

if (Ім'я є, у телефоні 10–15 цифр,\nдля доставки є адреса?) then (так)
else (ні)
  :помилка на формі, запит не йде;
  stop
endif

:POST /api/orders/\nлише product_id і quantity;

if (Сервер відповів 201?) then (так)
  :кошик очищено;
  :«Дякуємо за замовлення!»\nкнопка «Нове замовлення»;
  note right
    Це екран успіху, не статус.
    У базі замовлення «Нове».
    Кабінет, вкладка «Замовлення»,
    покаже той самий підпис.
  end note
  stop
else (ні)
  :текст помилки\nкошик лишається;
  stop
endif

@enduml
