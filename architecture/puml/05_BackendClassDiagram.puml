@startuml BackendClassDiagram
title Гастроном «Черемшина» — діаграма класів бекенду\nмоделі Django, без серіалізаторів і view

skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam roundCorner 6
hide circle
hide empty members

skinparam class {
  BackgroundColor #F5E6D3
  BorderColor #8c2240
  HeaderBackgroundColor #8c2240
  HeaderFontColor #FFFFFF
  FontColor #1a0508
}
skinparam enum {
  BackgroundColor #FFF8E7
  BorderColor #c4a574
  FontColor #1a0508
}
skinparam note {
  BackgroundColor #FFF8E7
  BorderColor #c4a574
  FontColor #1a0508
}
skinparam arrow {
  Color #5c2b2f
}

abstract class AbstractUser {
  password
  is_active : bool
  is_staff : bool
  is_superuser : bool
}

class UserManager {
  + create_user(email, password)
  + create_superuser(email, password)
}

class User {
  email : EmailField {unique}
  name : CharField
  phone : CharField
  city : CharField
  birthday : DateField
  photo : URLField
  auth_revision : PositiveInteger = 0
  + has_birthday_discount : bool
}

enum PreferenceTag {
  meat
  smoked
  cheese
  poultry
  coffee
  bread
  sauces
  vegetables
}

class UserPreference {
  tag : PreferenceTag
}

class Category {
  name : CharField
  slug : SlugField {unique}
  emoji : CharField
  order : PositiveInteger
  is_active : bool
}

class Product {
  external_id : CharField {unique}
  name : CharField
  slug : SlugField {unique}
  description : TextField
  price : Decimal
  price_display : CharField
  unit : CharField
  emoji : CharField
  image : ImageField
  is_available : bool
  is_featured : bool
  stock : PositiveInteger
  created_at : DateTime
  + unit_label : str
  + save()
}

class Cart {
  session_key : CharField
  created_at : DateTime
  updated_at : DateTime
  + total() : Decimal
  + items_count() : int
}

class CartItem {
  quantity : PositiveInteger
  + subtotal() : Decimal
}

class Order {
  name : CharField
  phone : CharField
  email : EmailField
  city : CharField
  address : CharField
  comment : TextField
  status : OrderStatus
  total : Decimal
  discount : Decimal
  final_total : Decimal
  is_quick : bool
  created_at : DateTime
  updated_at : DateTime
}

enum OrderStatus {
  new
  confirmed
  processing
  shipping
  delivered
  cancelled
}

class OrderItem {
  product_name : CharField
  product_price : Decimal
  quantity : PositiveInteger
  unit : CharField
  + subtotal() : Decimal
}

class Promotion {
  title : CharField
  slug : SlugField {unique}
  type : PromoType
  description : TextField
  badge : CharField
  badge_color : CharField
  is_active : bool
  order : PositiveInteger
  created_at : DateTime
}

enum PromoType {
  birthday
  subscription
  cheese_friday
  free_coffee
  other
}

AbstractUser <|-- User
UserManager "1" <-- User : objects
User "1" *-- "0..*" UserPreference : preferences
User "0..1" <-- "0..1" Cart : user,\nCASCADE
Cart "1" *-- "0..*" CartItem : items
CartItem "*" --> "1" Product
Category "1" *-- "0..*" Product : products,\nCASCADE
User "0..1" <-- "0..*" Order : user,\nSET_NULL
Order "1" *-- "0..*" OrderItem : items
OrderItem "*" --> "0..1" Product : SET_NULL

note right of User
  username вимкнено.
  USERNAME_FIELD = email.
  REQUIRED_FIELDS = name.
  createsuperuser питає email, не ім'я користувача.
  auth_revision зростає на logout:
  JWT із старим rev більше не приймається.
  has_birthday_discount — вікно ±7 днів
  (BIRTHDAY_DISCOUNT_WINDOW_DAYS), включно з переходом року.
end note

note bottom of Cart
  Cart і CartItem описані в models.py,
  але жоден view їх не читає і не пише.
  Кошик вітрини живе в браузері:
  localStorage cheremshyna_cart.
  POST /api/orders/ отримує items[] з цього кошика.
end note

note bottom of OrderItem
  product_name і product_price — знімок на момент покупки.
  Ціну з браузера сервер не бере: price читається з Product.
end note

note bottom of Promotion
  Зв'язку з Product немає.
  Знижку рахує orders.views._discount_for, не ця модель:
  −15% на все, якщо has_birthday_discount;
  інакше в п'ятницю −10% лише на категорію cheeses.
  subscription і free_coffee — текст на вітрині, у сумі не беруть участі.
  PromoCode у коді немає.
end note

@enduml
