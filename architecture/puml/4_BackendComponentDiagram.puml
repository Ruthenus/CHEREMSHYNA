@startuml BackendComponentDiagram
title Гастроном «Черемшина» — компоненти бекенду\nчотири застосунки Django і хто чим користується

skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam roundCorner 6

skinparam component {
  BackgroundColor #F5E6D3
  BorderColor #8c2240
  FontColor #1a0508
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #5c2b2f
  FontColor #1a0508
  FontStyle bold
}
skinparam database {
  BackgroundColor #EDE0D4
  BorderColor #8c2240
  FontColor #1a0508
}
skinparam note {
  BackgroundColor #FFF8E7
  BorderColor #c4a574
  FontColor #1a0508
}
skinparam arrow {
  Color #5c2b2f
}

package "config" {
  [settings.py\n.env поруч із manage.py\nSECRET_KEY обов'язковий] as Settings
  [urls.py\n/api/* і /admin/] as Urls
  [wsgi.py\nconfig.wsgi:application] as Wsgi
}

package "users" {
  [User\nUserPreference\nUserManager] as UserModel
  [EmailBackend\nвхід по email] as Email
  [RevisionJWTAuthentication\nclaim rev] as JWT
  [register login me logout] as UserViews
}

package "catalog" {
  [Category\nProduct] as CatModel
  [CategoryListView\nProductListView\nProductDetailView] as CatViews
  [seed_data] as Seed
}

package "orders" {
  [Order OrderItem\nCart CartItem] as OrdModel
  [OrderListCreateView\nOrderPreviewView\nOrderDetailView\nQuickOrderView] as OrdViews
}

package "promotions" {
  [Promotion] as PromoModel
  [PromotionViewSet\nReadOnly\n/promos/] as PromoViews
}

database "SQLite\ndb.sqlite3" as DB
folder "media/products" as Media
[simplejwt\naccess 1 доба\nrefresh 14 діб\nblacklist] as JwtLib
[drf-spectacular\n/api/docs/] as Docs

Wsgi --> Urls
Settings --> Wsgi
Urls --> UserViews
Urls --> CatViews
Urls --> OrdViews
Urls --> PromoViews
Urls --> Docs

UserViews --> UserModel
UserViews --> Email
UserViews --> JwtLib
JWT --> UserModel : rev дорівнює\nauth_revision
CatViews --> CatModel
Seed --> CatModel
Seed --> PromoModel
OrdViews --> OrdModel
OrdViews --> CatModel : ціна, stock,\nslug категорії
OrdViews --> UserModel : знижка ДН
PromoViews --> PromoModel

UserModel --> DB
CatModel --> DB
OrdModel --> DB
PromoModel --> DB
CatModel --> Media : ImageField

note bottom of OrdModel
  Cart і CartItem у моделі є.
  HTTP-маршруту кошика немає:
  рядки замовлення приходять у тілі POST.
end note

note bottom of CatViews
  Пошук ?search= на SQLite
  порівнює casefold у Python,
  щоб «гауда» знаходила «Гауда».
  Ціна в JSON — число, не рядок.
  image — відносний /media/..., без хоста.
end note

@enduml
