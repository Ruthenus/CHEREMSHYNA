@startuml FinalFrontendStructure
title Гастроном «Черемшина» — фінальний фронтенд\nReact викликає Django, кошик лишається в браузері

skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam roundCorner 8
skinparam componentStyle rectangle

skinparam component {
  BackgroundColor #F5E6D3
  BorderColor #8c2240
  FontColor #1a0508
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #5c2b2f
  FontColor #1a0508
  FontStyle bold
}
skinparam database {
  BackgroundColor #EDE0D4
  BorderColor #8c2240
  FontColor #1a0508
}
skinparam note {
  BackgroundColor #FFF8E7
  BorderColor #c4a574
  FontColor #1a0508
}
skinparam arrow {
  Color #5c2b2f
}

actor "Відвідувач" as User

package "Вхід" {
  [main.jsx] as Main
  [App.jsx\nBrowserRouter\ncart, addToCart] as App
}

package "Сесія" {
  [AuthContext.jsx\nlogin register logout\nupdateProfile addOrder] as Auth
  [api.js\naxios baseURL /api\nоновлення access на 401] as Api
}

database "localStorage" as LS {
  [cheremshyna_cart] as KeyCart
  [cheremshyna_token\naccess] as KeyAccess
  [cheremshyna_refresh] as KeyRefresh
  [cheremshyna_session\nкеш профілю, не пароль] as KeySession
}

package "Маршрут /" {
  [Header] as Header
  [Hero] as Hero
  [Products] as Products
  [Ticker] as Ticker
  [About] as About
  [Principles] as Principles
  [Contacts\nшвидке замовлення] as Contacts
  [Footer] as Footer
}

package "Інші маршрути" {
  [Login\n/login] as Login
  [Register\n/register] as Register
  [Cart\n/cart] as Cart
  [Order\n/order] as Order
  [Cabinet\n/profile і /cabinet] as Cabinet
}

node "Той самий домен" as APIHost {
  [Django /api] as Django
}

User --> Main
Main --> App
App --> Auth
App --> Header
App --> Hero
App --> Products
App --> Ticker
App --> About
App --> Principles
App --> Contacts
App --> Footer
App --> Login
App --> Register
App --> Cart
App --> Order
App --> Cabinet

Auth --> Api
Products --> Api : категорії, товари, акції
Contacts --> Api : POST /orders/quick/
Login --> Auth
Register --> Auth
Cabinet --> Auth
Order --> Auth : addOrder\nбез ціни в тілі
Cart --> App : зміна кількості\nмежа 99 і stock

App --> KeyCart
Auth --> KeySession
Api --> KeyAccess
Api --> KeyRefresh
Api --> Django : відносний /api\nVITE_API_BASE_URL порожній

note bottom of LS
  Старі ключі cheremshyna_users
  і cheremshyna_orders більше не джерело правди.
  Історія замовлень приходить з GET /api/orders/.
  PureFrontEndStructure.puml лишається
  знімком чистого фронтенду до підключення API.
end note

note bottom of Django
  У dev Vite на :62550 проксує /api і /media
  на runserver :8000.
  У прод проксі немає: nginx віддає dist
  і сам проксує /api.
end note

@enduml
