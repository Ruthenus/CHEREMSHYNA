# Локальний ключ для здачі. Замініть на свій.
# Файл .env у git не потрапляє (він у .gitignore).
DJANGO_SECRET_KEY=cheremshyna-local-only-change-before-any-public-server-2026-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Прод лежить у /etc/cheremshyna/env, не в git і не копія цього файлу.
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# DJANGO_SECRET_KEY=новий-довгий-ключ-не-з-локального-env